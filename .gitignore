# Docklift - Ignore List

# Node.js
node_modules/
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/

# Database
*.db
*.sqlite
*.sqlite3
data/*.db
# Accidental Prisma/SQLite scratch DBs (no extension — *.db does not match)
backend/prisma/memdb*

# Secrets (auto-generated, never commit)
.secrets
data/.secrets
backend/data/.secrets
.bootstrap-secret
data/.bootstrap-secret
**/.bootstrap-secret
.setup-token
data/.setup-token
**/.setup-token

# Local overrides only (committed .env = server/production defaults)
# Template to copy: backend/.env.local.example  →  backend/.env.local
.env.local
backend/.env.local
frontend/.env.local
**/.env.local
# Do NOT ignore *.example — those are committed templates

# Logs
*.log
logs/
# Allow Next.js app route for /logs page
!frontend/app/logs/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Deployments (user project files)
backend/deployments/*
!backend/deployments/.gitkeep

# Nginx proxy configs (auto-generated, keep default)
**/nginx-proxy/conf.d/*
!nginx-proxy/conf.d/.gitkeep
!nginx-proxy/conf.d/default.conf

# Let's Encrypt private keys / accounts (never commit)
**/nginx-proxy/certbot/conf/*
!nginx-proxy/certbot/conf/.gitkeep
**/nginx-proxy/certbot/www/*
!nginx-proxy/certbot/www/.gitkeep

# `bun run dev` resolves ./nginx-proxy and ./data from backend/, so a local run
# scatters generated vhosts, certs and uploads there. None of it belongs in git.
backend/nginx-proxy/
backend/data/

.claude/
AGENTS.md
CODEBASE_SUMMARY.md