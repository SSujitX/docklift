# =============================================================================
# DockLift backend — LOCAL DEVELOPMENT template (committed)
# =============================================================================
# Copy to .env.local and fill in your own values (never commit .env.local):
#
#   cp .env.local.example .env.local
#
# Loaded after .env and overrides it. Production/server defaults stay in .env.
# Frontend local UI: http://localhost:3600  |  Backend: http://localhost:8000
# =============================================================================

# Allow the Vite dashboard to call the API with credentials
CORS_ORIGIN=http://localhost:3600,http://127.0.0.1:3600

# UI URL for redirects / terminal Origin checks (Vite port, not :8080)
DOCKLIFT_FRONTEND_URL=http://localhost:3600

# Use Let's Encrypt staging if you test HTTPS locally (avoids rate limits)
CERTBOT_STAGING=true

# Optional: stable secrets for local (otherwise auto in data/.secrets)
# JWT_SECRET=
# INTERNAL_API_SECRET=

# Optional: GitHub App for local (or use Settings → Create App in the UI)
# DOCKLIFT_GITHUB_APP_ID=
# DOCKLIFT_GITHUB_CLIENT_ID=
# DOCKLIFT_GITHUB_CLIENT_SECRET=
# DOCKLIFT_GITHUB_PRIVATE_KEY_PATH=./github-app.pem

# Rare: allow terminal WS with no Origin header
# TERMINAL_ALLOW_NO_ORIGIN=true
