    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dockerode": "^4.0.12",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "simple-git": "^4.1.0",
    "systeminformation": "^5.33.26",
    "unzipper": "^0.12.5",
    "ws": "^8.23.0"
  },
  "overrides": {
