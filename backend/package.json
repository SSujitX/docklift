    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.47",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
