{
  "name": "docklift-backend",
  "version": "2.0.14",
  "description": "Docklift backend - Docker deployment platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "bun test src",
    "start": "node dist/index.js",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate deploy",
    "db:push": "bunx prisma db push",
    "db:ensure": "tsx src/scripts/ensureDb.ts",
    "db:studio": "bunx prisma studio",
    "reset-password": "tsx src/scripts/reset-password.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dockerode": "^4.0.12",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "simple-git": "^3.36.0",
    "systeminformation": "^5.33.1",
    "unzipper": "^0.12.5",
    "ws": "^8.21.1"
  },
  "overrides": {
    "protobufjs": "8.7.1",
    "uuid": "14.0.1",
    "path-to-regexp": "8.4.2",
