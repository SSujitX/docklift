generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String        @id @default(uuid())
  name           String
  description    String?
  source_type    String?
  project_type   String?
  github_url     String?
  github_branch  String?
  domain         String?
  port           Int?
  status         String?
  container_name String?
  auto_deploy    Boolean?      @default(false)
  webhook_secret String?
  build_type      String        @default("auto")
  base_directory String        @default(".")
  dockerfile_path String?
  internal_port  Int           @default(3000)
  /// When true, publish host ports (PORT_RANGE). Default false — reach apps via domain/proxy.
  publish_host_port Boolean     @default(false)
  /// Managed DB engine id when project_type=database (postgres|mysql|mariadb|redis|mongodb).
  db_engine      String?
  created_at     DateTime?     @default(now())
  updated_at     DateTime?     @default(now()) @updatedAt
  deployments    Deployment[]
  env_variables  EnvVariable[]
  services       Service[]
  ports          Port[]
  persistent_volumes PersistentVolume[]
  databaseLinksAsDb  DatabaseLink[] @relation("DatabaseLinksAsDb")
  databaseLinksAsApp DatabaseLink[] @relation("DatabaseLinksAsApp")

  @@map("projects")
}

/// Links a managed database project to an app project (optional per-service scope).
model DatabaseLink {
  id                  String    @id @default(uuid())
  database_project_id String
  app_project_id      String
  /// Empty string = shared env for every service on the app project.
  service_name        String    @default("")
  /// Env key written on the app (DATABASE_URL, REDIS_URL, MONGODB_URI).
  env_key             String
  created_at          DateTime? @default(now())
  database_project    Project   @relation("DatabaseLinksAsDb", fields: [database_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_project         Project   @relation("DatabaseLinksAsApp", fields: [app_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([database_project_id, app_project_id, service_name, env_key])
  /// One env key owner per app/service scope (prevents multi-DB DATABASE_URL collisions).
  @@unique([app_project_id, service_name, env_key])
  @@map("database_links")
}

model Deployment {
  id          String    @id @default(uuid())
  project_id  String
  status      String?
  trigger     String?   @default("manual")
  commit_message String?
  /// Git HEAD after pull (nullable for uploads / legacy rows)
  commit_sha  String?
  /// Map of service name → image tag after a successful deploy (for keep-2 + rollback)
  image_tags  Json?
  logs        String?
  created_at  DateTime? @default(now())
  finished_at DateTime?
  project     Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("deployments")
}

model Service {
  id              String    @id @default(uuid())
  project_id      String
  name            String
  dockerfile_path String
  container_name  String?
  port            Int?
  internal_port   Int?
  domain          String?
  status          String?
  created_at      DateTime? @default(now())
  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("services")
}

model PersistentVolume {
  id           String    @id @default(uuid())
  project_id   String
  service_name String
  name         String
  display_name String
  mount_path   String
  created_at   DateTime? @default(now())
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, name])
  @@unique([project_id, service_name, mount_path])
  @@map("persistent_volumes")
}

model EnvVariable {
  id           String    @id @default(uuid())
  project_id   String
  /// Empty string = shared to every service. Otherwise Docker service name (folder).
  service_name String    @default("")
  key          String
  value        String
  is_build_arg Boolean?
  is_runtime   Boolean?
  /// When true with is_build_arg: pass via BuildKit --secret, never --build-arg
  is_secret    Boolean?  @default(false)
  created_at   DateTime? @default(now())
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, service_name, key])
  @@map("env_variables")
}

model Port {
  port       Int      @id @default(autoincrement())
  project_id String?
  is_locked  Boolean?
  project    Project? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ports")
}

model Settings {
  key        String    @id
  value      String?
  updated_at DateTime?

  @@map("settings")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              String    @default("admin")
  passwordChangedAt DateTime? // when set, JWTs with iat before this are rejected
  created_at        DateTime  @default(now())

  @@map("users")
}
